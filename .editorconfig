root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt indents Go code and go.mod with tabs.
[{*.go,go.mod}]
indent_style = tab

# The build fixtures keep byte-level quirks on purpose, such as a
# plugin.json with tabs or no final newline, which cech build must keep.
[cli/internal/app/testdata/build/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# shfmt reads these for the POSIX sh scripts: executables with no
# extension and *.sh libraries.
[scripts/**]
shell_variant = posix
switch_case_indent = true
space_redirects = true
binary_next_line = false
function_next_line = false

# shfmt reads the dialect of the tests from their extension.
[test/**]
switch_case_indent = true
space_redirects = true
binary_next_line = false
function_next_line = false
