#!/bin/sh
# Optional hook (ADR 4): runs the pre-commit gates through mise.
# Enable with: git config core.hooksPath scripts/hooks
set -eu
command -v mise > /dev/null 2>&1 || {
  echo "pre-commit: mise not found; install it, then run mise trust and mise install" >&2
  exit 2
}
top=$(git rev-parse --show-toplevel)
cd -- "${top}"
exec mise run pre-commit
