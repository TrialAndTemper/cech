#!/bin/sh
# Run a command in a checkout of the index, so that a check sees the
# files as they are staged, not as they are on disk. The pre-commit task
# runs its lint and format checks through it (ADR 10). git commands run
# by the command see the repository's index, with the checkout as the
# work tree.
#
# Usage: scripts/staged-tree <command> [args...]
#
# Requires: git and mktemp.
#
# Exit status: the command's, or 2 if staged-tree cannot run (no library,
# no command, no repository, or no checkout).

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
readonly ROOT
# A failed `.` exits 1 in some shells, which would pass for the
# command's status, so check first.
[ -r "${ROOT}/scripts/lib/common.sh" ] || {
  printf 'staged-tree: cannot read scripts/lib/common.sh\n' >&2
  exit 2
}
# shellcheck source=lib/common.sh
. "${ROOT}/scripts/lib/common.sh"
PROG=staged-tree
readonly PROG

main() {
  local git_dir status

  case "${1:-}" in
    '') die "no command given" ;;
    -h | --help)
      sed -n 's/^# Usage: //p' "$0"
      exit 0
      ;;
    *) ;;
  esac

  git_dir=$(git rev-parse --absolute-git-dir) || die "not in a git repository"
  # During a commit git can name the index by a path relative to this
  # directory; keep it valid inside the checkout.
  case "${GIT_INDEX_FILE:-/}" in
    /*) ;;
    *)
      GIT_INDEX_FILE="$(pwd)/${GIT_INDEX_FILE}"
      export GIT_INDEX_FILE
      ;;
  esac
  make_scratch
  git checkout-index -a --ignore-skip-worktree-bits --prefix="${SCRATCH}/tree/" || die "cannot check out the index"

  cd -- "${SCRATCH}/tree"
  status=0
  GIT_DIR=${git_dir} GIT_WORK_TREE=${SCRATCH}/tree "$@" || status=$?
  return "${status}"
}

main "$@"
