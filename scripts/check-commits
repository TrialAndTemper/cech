#!/bin/sh
# Commit message gate (ADR 4, ADR 6 item 7), with the DCO sign-off of
# ADR 2. Run as `mise run commits`.
# POSIX sh (ADR 4): it must run under dash, macOS sh and Git Bash.
#
# Usage: mise run commits -- [--message FILE | --range RANGE]
#
#   (none)         the commits in CECH_RANGE if it is set (CI), else
#                  the commits missing from origin/main (every commit
#                  reachable from HEAD if origin/main is absent)
#   --message FILE one commit message (commit-msg hook)
#   --range RANGE  the commits in a revision range
#   -h, --help     show usage
#
# Each message needs:
#   - a Conventional Commits header (ADR 6, item 4): a type from ADR 6
#     (TYPES below), an optional scope of lower-case words joined by `-`
#     and starting with a letter, as ADR 12 names plugins, an optional
#     `!`, then `: ` and a summary with no final full stop; at most 72
#     characters of UTF-8, whatever the locale;
#   - a blank line after the header, if anything follows it;
#   - a `Signed-off-by:` trailer whose email is the author's. With
#     --message the author is the one git will record, which git passes
#     to the commit-msg hook; with no author configured, any sign-off
#     passes.
# A message whose header starts with `fixup!`, `squash!` or `amend!`
# passes in --message mode, so `git commit --fixup` works, and fails in
# the other modes until it is folded in with `git rebase --autosquash`.
# A merge commit fails in a range: main keeps linear history (ADR 6),
# so a branch is rebased onto main, not merged with it.
#
# Findings name the commit and the rule, never the message text, which
# could hold a private term (ADR 3).
#
# Requires: git, and the POSIX awk, sed, tr, wc and mktemp.
#
# Exit status: 0 clean, 1 findings, 2 the check could not run.

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
readonly ROOT
# A failed `.` exits 1 in some shells; 1 means findings, so check first.
[ -r "${ROOT}/scripts/lib/common.sh" ] || {
  printf 'commits: cannot read scripts/lib/common.sh\n' >&2
  exit 2
}
# shellcheck source=lib/common.sh
. "${ROOT}/scripts/lib/common.sh"
PROG=commits
readonly PROG
readonly TYPES='feat fix docs refactor perf test build ci chore revert'

MODE=default
ARG=''
FOUND=0

usage() {
  cat << 'EOF'
Usage: mise run commits -- [--message FILE | --range RANGE]

  (none)         the commits in CECH_RANGE if set, else the commits
                 missing from origin/main
  --message FILE one commit message
  --range RANGE  the commits in a revision range

Each message needs a Conventional Commits header of at most 72
characters, a blank line after it, and a Signed-off-by: trailer that
carries the author's email. fixup!, squash! and amend! commits pass
only in --message mode.
Exit status: 0 clean, 1 findings, 2 the check could not run.
EOF
}

parse_args() {
  local used
  used=1
  case "${1:-}" in
    '') used=0 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --message | --range)
      [ "$#" -ge 2 ] || die "$1 needs a value"
      # A value such as --all or --output=x would reach git as an option.
      case "$2" in
        -*) die "$1 value must not start with -: $2" ;;
        *) ;;
      esac
      MODE=${1#--}
      ARG=$2
      used=2
      ;;
    *)
      usage >&2
      die "unknown option: $1"
      ;;
  esac
  shift "${used}"
  if [ "$#" -ne 0 ]; then
    usage >&2
    die "unexpected argument: $1"
  fi
  if [ "${MODE}" = message ] && [ ! -r "${ARG}" ]; then
    die "cannot read message file: ${ARG}"
  fi
  # CI sets the range once for every gate that `mise run check` runs.
  if [ "${MODE}" = default ] && [ -n "${CECH_RANGE:-}" ]; then
    case "${CECH_RANGE}" in
      -*) die "CECH_RANGE must not start with -: ${CECH_RANGE}" ;;
      *) ;;
    esac
    MODE=range
    ARG=${CECH_RANGE}
  fi
}

# finding <where> <text>: report one broken rule.
finding() {
  printf '%s: %s\n' "$1" "$2"
  FOUND=1
}

# clean_message <file>: print the message as git will store it: cut at
# the scissors line of `git commit -v`, then let git drop comments,
# trailing spaces and extra blank lines. The comment string comes from
# core.commentString, then core.commentChar; with `auto` git picks one
# per message, and this assumes `#` for the scissors.
clean_message() {
  local cc
  cc=$(git -C "${ROOT}" config core.commentString) ||
    cc=$(git -C "${ROOT}" config core.commentChar) || cc=''
  case "${cc}" in
    '' | auto) cc='#' ;;
    *) ;;
  esac
  awk -v cc="${cc}" '
    { line = $0; sub(/\r$/, "", line) }
    line == cc " ------------------------ >8 ------------------------" { exit }
    { print }
  ' "$1" > "${SCRATCH}/raw"
  git -C "${ROOT}" stripspace --strip-comments < "${SCRATCH}/raw" ||
    die "git stripspace failed"
}

# check_header <where> <header>: the Conventional Commits header rules.
check_header() {
  local where header type rest scope summary chars
  where=$1 header=$2
  case "${header}" in
    'Revert "'*)
      finding "${where}" "git's revert header; use revert: and the reverted header"
      return
      ;;
    *) ;;
  esac
  type=${header%%[(!:]*}
  rest=${header#"${type}"}
  case " ${TYPES} " in
    *" ${type} "*) ;;
    *)
      finding "${where}" "header type is not one of: ${TYPES}"
      return
      ;;
  esac
  case "${rest}" in
    '('*)
      scope=${rest%%)*}
      scope=${scope#(}
      rest=${rest#*)}
      if [ -z "${scope}" ] ||
        ! printf '%s\n' "${scope}" | grep -Eqx '[a-z][a-z0-9]*(-[a-z0-9]+)*'; then
        finding "${where}" "header scope is not lower-case words joined by -, starting with a letter"
      fi
      ;;
    *) ;;
  esac
  rest=${rest#!}
  summary=${rest#: }
  if [ "${summary}" = "${rest}" ] || [ -z "${summary}" ]; then
    finding "${where}" "header lacks ': ' and a summary after the type and scope"
  else
    case "${summary}" in
      ' '* | *' ') finding "${where}" "header summary starts or ends with a space" ;;
      *.) finding "${where}" "header ends with a full stop" ;;
      *) ;;
    esac
  fi
  # Count bytes that do not continue a UTF-8 character, so the count is
  # the same in every locale.
  chars=$(printf '%s' "${header}" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
  if [ "${chars}" -gt 72 ]; then
    finding "${where}" "header is ${chars} characters, more than 72"
  fi
}

# check_message <where> <file> [<author email>]: every rule on one
# message, already cleaned as git stores it.
check_message() {
  local where file email header second signoffs
  where=$1 file=$2 email=${3:-}
  header=$(sed -n 1p "${file}" | tr -d '\r')
  case "${header}" in
    'fixup! '* | 'squash! '* | 'amend! '*)
      if [ "${MODE}" != message ]; then
        finding "${where}" "fold this commit in with git rebase --autosquash"
      fi
      return
      ;;
    *) ;;
  esac
  if ! grep -q '[^[:space:]]' "${file}"; then
    finding "${where}" "message is empty"
    return
  fi
  if [ -z "${header}" ]; then
    finding "${where}" "line 1 is blank"
    return
  fi
  check_header "${where}" "${header}"
  second=$(sed -n 2p "${file}" | tr -d '\r')
  if [ -n "${second}" ]; then
    finding "${where}" "line 2 is not blank"
  fi

  git -C "${ROOT}" interpret-trailers --parse < "${file}" > "${SCRATCH}/trailers" ||
    die "git interpret-trailers failed"
  # git accepts the key in any case.
  signoffs=$(sed -n 's/^[Ss][Ii][Gg][Nn][Ee][Dd]-[Oo][Ff][Ff]-[Bb][Yy]: *//p' "${SCRATCH}/trailers")
  if [ -z "${signoffs}" ]; then
    finding "${where}" "no Signed-off-by: trailer (git commit -s)"
  elif [ -n "${email}" ] &&
    ! printf '%s\n' "${signoffs}" | sed -n 's/.*<\([^<>]*\)>[[:space:]]*$/\1/p' |
    grep -Fixq -- "${email}"; then
    finding "${where}" "no Signed-off-by: trailer carries the author's email"
  fi
}

# check_range <range>: every commit in the range, oldest first. rev-list
# prints each commit with its parents, so a merge has two or more.
check_range() {
  local c parents where email
  git -C "${ROOT}" rev-list --reverse --parents "$1" > "${SCRATCH}/revs" 2> /dev/null ||
    die "bad revision range: $1"
  if [ ! -s "${SCRATCH}/revs" ]; then
    echo "commits: no commits to check"
    return
  fi
  while read -r c parents; do
    where="commit $(printf '%.12s' "${c}")"
    case "${parents}" in
      *' '*)
        finding "${where}" "merge commit; rebase the branch onto main instead"
        continue
        ;;
      *) ;;
    esac
    git -C "${ROOT}" log -1 --format='%ae%n%B' "${c}" > "${SCRATCH}/commit" ||
      die "cannot read commit ${c}"
    email=$(sed -n 1p "${SCRATCH}/commit")
    sed 1d "${SCRATCH}/commit" > "${SCRATCH}/message"
    check_message "${where}" "${SCRATCH}/message" "${email}"
  done < "${SCRATCH}/revs"
}

# author_email: the email git will record as the author of the commit
# being made: GIT_AUTHOR_EMAIL, which git sets for the commit-msg hook,
# or the configured one. Empty if none is configured.
author_email() {
  local ident
  ident=$(git -C "${ROOT}" -c user.useConfigOnly=true var GIT_AUTHOR_IDENT 2> /dev/null) ||
    return 0
  printf '%s\n' "${ident}" | sed -n 's/.*<\([^<>]*\)>.*/\1/p'
}

main() {
  local email
  parse_args "$@"

  make_scratch

  case "${MODE}" in
    message)
      clean_message "${ARG}" > "${SCRATCH}/message"
      email=$(author_email)
      check_message message "${SCRATCH}/message" "${email}"
      ;;
    range) check_range "${ARG}" ;;
    default)
      if git -C "${ROOT}" rev-parse -q --verify origin/main > /dev/null; then
        check_range origin/main..HEAD
      elif git -C "${ROOT}" rev-parse -q --verify HEAD > /dev/null; then
        check_range HEAD
      else
        echo "commits: no commits to check"
      fi
      ;;
    *) die "unknown mode: ${MODE}" ;;
  esac

  if [ "${FOUND}" != 0 ]; then
    echo "commits: findings; see ADR 6 for the message format" >&2
    exit 1
  fi
  echo "commits: ok"
}

main "$@"
